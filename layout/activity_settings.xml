<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Dark Mode -->
    <LinearLayout
        android:id="@+id/settings_dark_mode_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="深色模式"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_dark_mode_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/divider" android:layout_marginStart="16dp" />

    <!-- Clear Cache -->
    <LinearLayout
        android:id="@+id/settings_clear_cache_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清除缓存"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/settings_cache_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 MB"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorHint" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/divider" android:layout_marginStart="16dp" />

    <!-- About -->
    <LinearLayout
        android:id="@+id/settings_about_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="关于"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorHint" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/divider" android:layout_marginStart="16dp" />

    <!-- Logout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center|bottom"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/settings_logout_btn"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="退出登录"
            android:textSize="15sp"
            android:textColor="@color/status_canceled"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>
</LinearLayout>
